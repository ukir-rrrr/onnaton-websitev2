# Copy to .env.local and fill in from each dashboard.
# Never commit .env.local or paste secrets in chat.

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Default site slug (matches sites.slug in DB)
SITE_SLUG=onnaton

# --- Resend (API Keys) — Phase 2+ ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=reservations@your-domain.com
RESEND_OWNER_TO=owner@example.com
RESEND_REPLY_TO=owner@example.com

# --- Admin (/admin/notices) — Phase 1 ---
# Use ONNATON_ prefix (Windows may already define ADMIN_PASSWORD).
ONNATON_ADMIN_PASSWORD=choose_a_strong_password

# --- Optional: existing reservation webhook ---
RESERVATION_WEBHOOK_URL=
