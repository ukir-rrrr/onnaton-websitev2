# Copy to .env.local and fill in from each dashboard.
# Never commit .env.local or paste secrets in chat.

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Default site slug (matches sites.slug in DB)
SITE_SLUG=onnaton

# --- Resend (API Keys) — Phase 2+ ---
# From は Resend で DNS 認証（SPF/DKIM）済みのドメインのアドレスのみ指定可（送信専用・受信箱は不要）。
# Gmail など未認証ドメインは From に使えない。
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=reservations@onnaton.com
# 予約通知の受信先。Gmail 可（オーナーが予約内容を受け取る受信箱）。
RESEND_OWNER_TO=onnaton.reserve@gmail.com
# 自動返信メールの Reply-To。オーナーの Gmail に集約すると返信が1スレッドにまとまる。
RESEND_REPLY_TO=onnaton.reserve@gmail.com

# --- Admin (/admin/notices) — Phase 1 ---
# Use ONNATON_ prefix (Windows may already define ADMIN_PASSWORD).
ONNATON_ADMIN_PASSWORD=choose_a_strong_password

# --- Optional: existing reservation webhook ---
RESERVATION_WEBHOOK_URL=
